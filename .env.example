DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports_insights
REDIS_URL=redis://localhost:6379
SPORTSDATAIO_API_KEY=
SPORTSDATAIO_BASE_URL=https://api.sportsdata.io/v4/soccer
# NBA basketball: stats.nba.com primary, ESPN site API auto-fallback when nba.com is blocked
NBA_PROVIDER=auto
NBA_STATS_BASE_URL=https://stats.nba.com/stats
NBA_STATS_TIMEOUT_MS=8000
ESPN_NBA_TIMEOUT_MS=15000
API_KEYS=dev-key-1,dev-key-2
PORT=5000
NODE_ENV=development
